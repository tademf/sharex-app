<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- MAIN CONTENT -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF">

        <!-- TOP GREEN BAR -->
        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="#009688"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_menu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="48dp"
                android:text="SHAREX"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/scanQrButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_qr"
                android:tint="#FFFFFF" />
        </RelativeLayout>

        <!-- TAB LAYOUT -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/topBar"
            android:background="#009688"
            app:tabIndicatorColor="#FFFFFF"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabTextColor="#B2DFDB"
            app:tabMode="scrollable"
            app:tabGravity="fill"
            app:tabMinWidth="80dp" />

        <!-- SEARCH & TOGGLE BAR (Pinned below tabs, hidden by default) -->
        <LinearLayout
            android:id="@+id/musicControlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tabLayout"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone"
            android:gravity="center_vertical"
            android:background="#F5F5F5">
            
            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="Search music..."
                android:textColor="#212121"
                android:background="#FFFFFF"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_marginRight="8dp"
                android:singleLine="true"/>

            <Button
                android:id="@+id/toggleGridView"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Grid"
                android:textColor="#FFFFFF"
                android:backgroundTint="#009688"/>
        </LinearLayout>

        <!-- CONTENT AREA (ScrollView) -->
        <ScrollView
            android:id="@+id/mainScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/musicControlBar"
            android:layout_above="@id/bottomPlayerBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Connection Section -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Windows IP" android:textColor="#757575" android:textSize="12sp"/>
                <EditText android:id="@+id/serverIpInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="192.168.137.1" android:textColor="#212121"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pairing Token" android:textColor="#757575" android:textSize="12sp" android:layout_marginTop="8dp"/>
                <EditText android:id="@+id/tokenInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Paste token" android:textColor="#212121"/>

                <!-- Action Buttons -->
                <Button
                    android:id="@+id/selectFileButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Select File"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#009688"
                    android:layout_marginTop="16dp"/>

                <Button
                    android:id="@+id/sendButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Transfer Now"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#009688"
                    android:enabled="false"
                    android:layout_marginTop="8dp"/>

                <!-- Progress & Status -->
                <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:progressTint="#009688" android:visibility="gone" android:layout_marginTop="8dp"/>
                <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ready" android:textColor="#009688" android:layout_marginTop="8dp"/>

                <!-- RECYCLERVIEWS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/photoRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/musicRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <!-- Hidden buttons -->
                <Button android:id="@+id/cancelButton" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
                <Button android:id="@+id/startReceiverButton" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>
                <TextView android:id="@+id/receiverStatusText" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone"/>

            </LinearLayout>
        </ScrollView>

        <!-- BOTTOM MUSIC PLAYER BAR -->
        <RelativeLayout
            android:id="@+id/bottomPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:fitsSystemWindows="true"
            android:background="#212121"
            android:visibility="gone"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <TextView
                android:id="@+id/currentSongTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toLeftOf="@id/playPauseBtn"
                android:text="Song Name"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="14sp"/>

            <ImageButton
                android:id="@+id/playPauseBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerInParent="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_play"
                android:tint="#009688"/>

            <ImageButton
                android:id="@+id/nextBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_media_next"
                android:tint="#FFFFFF"/>
        </RelativeLayout>

    </RelativeLayout>

    <!-- SIDEBAR (DRAWER) -->
    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:background="#009688"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/ic_person" android:background="#FFFFFF" android:backgroundTint="#FFFFFF" android:padding="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SHAREX User" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="8dp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="  Profile" android:padding="16dp" android:textSize="16sp" android:textColor="#212121"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="  Language" android:padding="16dp" android:textSize="16sp" android:textColor="#212121"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="  Settings" android:padding="16dp" android:textSize="16sp" android:textColor="#212121"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="  About" android:padding="16dp" android:textSize="16sp" android:textColor="#212121"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="  Rate Us" android:padding="16dp" android:textSize="16sp" android:textColor="#212121"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>